# Copy to .env and adjust. Never commit the real .env.

# --- ports -----------------------------------------------------------------
API_PORT=8000
DASHBOARD_PORT=8501
MLFLOW_PORT=5000

# --- MLflow ----------------------------------------------------------------
# Local default is sqlite. MLflow 3.x no longer supports the ./mlruns file store.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Production example:
# MLFLOW_TRACKING_URI=postgresql://user:password@host:5432/mlflow

# --- dashboard -> API ------------------------------------------------------
API_URL=http://localhost:8000

# --- optional: AWS deployment ----------------------------------------------
# AWS_REGION=ap-south-1
# ECR_REGISTRY=<account-id>.dkr.ecr.ap-south-1.amazonaws.com
